# Registration token from Takaro: Game Servers -> Add Server -> Minecraft
TAKARO_REGISTRATION_TOKEN=your-registration-token-here

# Minecraft Paper server configuration
TAKARO_MC_IDENTITY_TOKEN=unique-mc-identity
RCON_PASSWORD=takaro123
TAKARO_WS_URL=wss://connect.takaro.io
TAKARO_PLUGIN_VERSION=0.0.5

# Multi-instance support
# Set INSTANCE_ID (0-9) to run multiple clones simultaneously, then generate the
# port variables below with: ./instance-env.sh <id> >> .env
INSTANCE_ID=0
MC_PORT=25665
RCON_PORT=25675
BOT_PORT=3101
