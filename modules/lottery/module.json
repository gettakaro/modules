{
  "name": "lottery",
  "author": "Takaro",
  "description": "Players can buy tickets for a lottery, and the winner is chosen at random.",
  "version": "1.0.0",
  "supportedGames": [
    "all"
  ],
  "config": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "profitMargin": {
        "type": "number",
        "maximum": 1,
        "minimum": 0,
        "description": "The profit margin the server takes from the lottery.",
        "default": 0.1
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "permissions": [
    {
      "permission": "LOTTERY_BUY",
      "friendlyName": "Buy Lottery Tickets",
      "canHaveCount": false,
      "description": "Allows the player to buy lottery tickets."
    },
    {
      "permission": "LOTTERY_VIEW_TICKETS",
      "friendlyName": "View Lottery Tickets",
      "description": "Allows the player to view his lottery tickets.",
      "canHaveCount": false
    }
  ],
  "commands": {
    "buyTicket": {
      "trigger": "buyTicket",
      "description": null,
      "helpText": "Buy a lottery ticket.",
      "function": "src/commands/buyTicket/index.js",
      "arguments": [
        {
          "name": "amount",
          "type": "number",
          "helpText": "The amount of tickets to buy.",
          "position": 0,
          "defaultValue": null
        }
      ],
      "requiredPermissions": [
        "LOTTERY_BUY"
      ]
    },
    "viewTickets": {
      "trigger": "viewTickets",
      "description": null,
      "helpText": "View your lottery tickets.",
      "function": "src/commands/viewTickets/index.js",
      "arguments": [],
      "requiredPermissions": [
        "LOTTERY_VIEW_TICKETS"
      ]
    },
    "nextDraw": {
      "trigger": "nextDraw",
      "description": null,
      "helpText": "View when the next draw is.",
      "function": "src/commands/nextDraw/index.js",
      "arguments": []
    }
  },
  "cronJobs": {
    "drawLottery": {
      "temporalValue": "0 0 * * *",
      "description": null,
      "function": "src/cronjobs/drawLottery/index.js"
    }
  }
}
